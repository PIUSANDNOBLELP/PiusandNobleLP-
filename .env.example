# Neon Postgres connection string (Prisma 7 reads this from prisma.config.ts,
# not from schema.prisma). DATABASE_URL_POOLED is an optional fallback lib/prisma.ts
# falls back to if DATABASE_URL isn't set.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Cloudinary — image uploads for team photos and insight covers.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Seeded on first `npm run db:seed` — change the password after first login.
ADMIN_SEED_EMAIL="admin@piusandnoble.com"
ADMIN_SEED_PASSWORD="change-me-now"
ADMIN_SEED_NAME="Admin"

# Used to build invite links shown to the inviting admin.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend — contact form delivery (server-side; the key never reaches the browser).
# Sign up at resend.com, create an API key, and paste it here.
RESEND_API_KEY=""
# Where website enquiries are delivered. Test: stoneachi@gmail.com. Prod: the firm inbox.
CONTACT_TO_EMAIL="stoneachi@gmail.com"
# Verified sender. Use onboarding@resend.dev for testing (only delivers to the
# address you signed up with), or website@yourdomain.com once it's verified.
CONTACT_FROM_EMAIL="onboarding@resend.dev"
CONTACT_FROM_NAME="Pius & Noble LP"
