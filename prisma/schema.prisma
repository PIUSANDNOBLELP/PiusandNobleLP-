generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  sessions    AdminSession[]
  invitesSent AdminInvite[]  @relation("InvitedBy")
  content     Content[]
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  @@index([adminId])
}

// Invite links are one-time: usedAt is set the moment they're claimed.
model AdminInvite {
  id               String    @id @default(cuid())
  tokenHash        String    @unique
  email            String?
  invitedByAdminId String
  invitedBy        Admin     @relation("InvitedBy", fields: [invitedByAdminId], references: [id])
  expiresAt        DateTime
  usedAt           DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
}

model TeamMember {
  id            String            @id @default(cuid())
  name          String
  role          String
  level         TeamLevel         @default(ASSOCIATE)
  focus         String
  qualifications String?
  expertise     String?
  photoUrl      String?
  displayOrder  Int               @default(0)
  status        PublicationStatus @default(DRAFT)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, displayOrder])
  @@index([level])
}

// Backs both "Insights" (long-form, has its own detail page) and "Updates"
// (short, shown inline only) — same shape, split by `kind`. `category` keeps
// the existing Explainer/Regulation/Firm news tag filter, independent of kind.
model Content {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  kind        ContentType
  category    String?
  excerpt     String?
  coverImage  String?
  body        String
  status      PublicationStatus @default(DRAFT)
  publishedAt DateTime?
  authorId    String?
  author      Admin?            @relation(fields: [authorId], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, publishedAt])
  @@index([kind])
}

// Editable legal pages (Privacy Policy, Terms of Use) managed from the admin.
model LegalPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
}

enum TeamLevel {
  PARTNER
  ASSOCIATE
}

enum ContentType {
  INSIGHT
  UPDATE
}
